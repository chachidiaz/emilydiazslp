---
// Shared layout for the "Let's get started with …" service pages
// (/evals/, /therapy-2/, /schoolcontracts/): pink hero, "How it works" steps,
// "Ready to get started?", an inquiry form over a photo, and an optional FAQ.
// The form posts to /contact-submit.php, which emails it (see that file).
import BaseLayout from "../layouts/BaseLayout.astro";

interface Step { title: string; body: string }
interface Props {
  pageTitle: string;
  description?: string;
  /** Big script title under "Let's get started with" */
  title: string;
  titleSize?: number;
  /** Icon above "How it works" */
  stepsImage: string;
  stepsImageAlt?: string;
  steps: Step[];
  /** Font of the step paragraphs, as on the old pages */
  stepText?: "poppins-19" | "poppins-18" | "worksans-20";
  readyText: string;
  formTitle: string;
  /** Key of the form in public/contact-submit.php */
  formKey: "aac-evaluation" | "speech-therapy" | "school-contracts";
  /** Label sizes (the therapy form used slightly smaller labels) */
  formSize?: "regular" | "small";
  submitWidth?: number;
  /** FAQ as HTML (question in <strong>, answer in <p>); leave out for none */
  faq?: string;
  /** Section padding around the form card (therapy used 4% on phones) */
  mobileFormPad?: string;
}

const {
  pageTitle,
  description,
  title,
  titleSize = 171,
  stepsImage,
  stepsImageAlt = "",
  steps,
  stepText = "poppins-19",
  readyText,
  formTitle,
  formKey,
  formSize = "regular",
  submitWidth = 336,
  faq,
  mobileFormPad = "3%",
} = Astro.props;

const rows: Step[][] = [];
for (let i = 0; i < steps.length; i += 2) rows.push(steps.slice(i, i + 2));
const stepIcons = ["one-circle.png", "two-circle.png", "three-circle.png", "four-circle.png"];
const isSchool = formKey === "school-contracts";
---

<BaseLayout title={pageTitle} description={description}>
  <section class="gs-hero">
    <p class="gs-tagline">Let's get started with</p>
    <h1 class="gs-title" style={`--title-size:${titleSize}px`}>{title}</h1>
    <slot name="hero" />
  </section>

  <section class="gs-how">
    <div class="gs-how-inner">
      <img class="gs-how-icon" src={stepsImage} alt={stepsImageAlt} width="197" height="197" />
      <h2 class="gs-how-title">How it works</h2>
      {rows.map((row, r) => (
        <div class:list={["gs-row", { single: rows.length === 1 }]}>
          {row.map((step, i) => (
            <div class="gs-step">
              <img src={`/images/${stepIcons[r * 2 + i]}`} alt={`Step ${r * 2 + i + 1}`} width="75" height="74" loading="lazy" />
              <h3 class="gs-step-title">{step.title}</h3>
              <div class:list={["gs-step-text", stepText]} set:html={step.body} />
            </div>
          ))}
        </div>
      ))}
      <div class="gs-divider" aria-hidden="true"></div>
      <div class="gs-ready">
        <h2 class="gs-ready-title">Ready to get started?</h2>
        <p class="gs-ready-text">{readyText}</p>
        <a class="gs-down" href="#inquiry-form" aria-label="Jump to the form">
          <img src="/images/circle-button.png" alt="" width="110" height="110" />
        </a>
      </div>
    </div>
  </section>

  <section class="gs-form-section" style={`--pad:${mobileFormPad}`}>
    <div class="gs-card" id="inquiry-form">
      <h2 class="gs-form-title">{formTitle}</h2>
      <p class="gs-msg ok" id="form-sent" hidden>Thank you! Your inquiry has been sent. We'll be in touch soon.</p>
      <p class="gs-msg err" id="form-error" hidden>
        Sorry, something went wrong. Please check the required fields and try again.
      </p>
      <form class:list={["gs-form", formSize]} action="/contact-submit.php" method="post">
        <input type="hidden" name="form" value={formKey} />
        <div class="hp" aria-hidden="true">
          <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        {isSchool ? (
          <>
            <fieldset class="field">
              <legend class="label">Name</legend>
              <div class="split">
                <label class="sub"><input type="text" name="name_first" autocomplete="given-name" />First</label>
                <label class="sub"><input type="text" name="name_last" autocomplete="family-name" />Last</label>
              </div>
            </fieldset>
            <div class="split">
              <label class="field"><span class="label">Email</span><input type="email" name="email" autocomplete="email" required /></label>
              <label class="field"><span class="label">Phone</span><input type="tel" name="phone" autocomplete="tel" /></label>
            </div>
            <label class="field"><span class="label">School District or Educational Organization Name</span><input type="text" name="district" autocomplete="organization" /></label>
            <fieldset class="field checks">
              <legend class="label">I'd like more information about:</legend>
              {["Speech-language therapy services", "AAC evaluations", "AAC consulting"].map((v) => (
                <label class="check"><input type="checkbox" name="interests[]" value={v} />{v}</label>
              ))}
              <button type="button" class="select-all">Select All</button>
            </fieldset>
          </>
        ) : (
          <>
            <fieldset class="field">
              <legend class="label">Client's Name <span class="req">(Required)</span></legend>
              <div class="split">
                <label class="sub"><input type="text" name="client_first" required />First</label>
                <label class="sub"><input type="text" name="client_last" required />Last</label>
              </div>
            </fieldset>
            <label class="field">
              <span class="label">Client's DOB <span class="req">(Required)</span></span>
              <input type="text" name="client_dob" inputmode="numeric" required />
              <span class="desc">MM/DD/YYYY</span>
            </label>
            <fieldset class="field">
              <legend class="label">Parent/Guardian's Name <span class="req">(Required)</span></legend>
              <div class="split">
                <label class="sub"><input type="text" name="parent_first" autocomplete="given-name" required />First</label>
                <label class="sub"><input type="text" name="parent_last" autocomplete="family-name" required />Last</label>
              </div>
            </fieldset>
            <label class="field"><span class="label">Email <span class="req">(Required)</span></span><input type="email" name="email" autocomplete="email" required /></label>
            <label class="field"><span class="label">Phone</span><input type="tel" name="phone" autocomplete="tel" placeholder="(XXX) XXX-XXXX" /></label>
            <label class="field">
              <span class="label">Where are you located? <span class="req">(Required)</span></span>
              <input type="text" name="location" required />
              <span class="desc">City, State, Country</span>
            </label>
            <label class="field">
              <span class="label">Please share details about what you're looking for. <span class="req">(Required)</span></span>
              <textarea name="details" rows="10" required></textarea>
            </label>
          </>
        )}

        <button class="submit" type="submit" style={`--submit-w:${submitWidth}px`}>Submit</button>
      </form>
    </div>
  </section>

  {faq && (
    <section class="gs-faq">
      <img class="gs-faq-icon" src="/images/qa.png" alt="" width="120" height="120" loading="lazy" />
      <h2 class="gs-faq-title">Frequently Asked Questions</h2>
      <div class="gs-faq-text" set:html={faq} />
    </section>
  )}
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const show = (id: string) => {
    document.getElementById(id)?.removeAttribute("hidden");
    document.getElementById("inquiry-form")?.scrollIntoView();
  };
  if (params.has("sent")) show("form-sent");
  else if (params.has("error")) show("form-error");

  document.querySelector(".select-all")?.addEventListener("click", (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const boxes = [...document.querySelectorAll<HTMLInputElement>('input[name="interests[]"]')];
    const all = boxes.every((b) => b.checked);
    boxes.forEach((b) => (b.checked = !all));
    btn.textContent = all ? "Select All" : "Deselect All";
  });
</script>

<style>
  /* Hero */
  .gs-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 8% 0;
    background-image: linear-gradient(142deg, #FFF3F7 0%, #FFFFFF 100%);
    text-align: center;
  }
  .gs-tagline {
    margin: 0 0 -8px;
    font-family: Poppins, sans-serif;
    font-size: 43px;
    font-weight: 300;
    line-height: 43px;
    letter-spacing: -0.5px;
    color: #C45B8F;
  }
  .gs-title {
    margin: 0 0 26px;
    padding-top: 0;
    font-family: "Orange and Lemons Caps", sans-serif;
    font-size: var(--title-size);
    font-weight: 400;
    line-height: 0.6em;
    letter-spacing: -1px;
    text-shadow: 3px 2px 0 #fff;
    color: #743E5A;
  }

  /* How it works */
  .gs-how { display: flex; justify-content: center; }
  .gs-how-inner {
    position: relative;
    width: 100%;
    max-width: 1000px;
    margin-top: -100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .gs-how-icon { width: 197px; display: block; }
  .gs-how-title {
    padding: 10px 10px 60px;
    transform: translateX(12px);
    font-family: Poppins, sans-serif;
    font-size: 59px;
    font-weight: 900;
    line-height: 59px;
    letter-spacing: -0.5px;
    color: #C45B8F;
    text-align: center;
  }
  .gs-row { display: flex; width: 100%; align-items: flex-start; }
  .gs-row + .gs-row { margin-top: 30px; }
  .gs-row.single { margin-bottom: 30px; }
  .gs-step {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 40px;
    text-align: center;
  }
  .gs-step img { width: 75px; display: block; }
  .gs-step-title {
    font-family: Poppins, sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 22px;
    letter-spacing: -0.5px;
    color: #C45B8F;
  }
  .gs-step-text { width: 100%; }
  .gs-step-text :global(p) { margin: 0 0 14.4px; }
  .gs-step-text.poppins-19 { font: 400 19px/31px Poppins, sans-serif; color: #3F3F3F; }
  .gs-step-text.poppins-18 { font: 400 18px/31px Poppins, sans-serif; color: #3F3F3F; }
  .gs-step-text.worksans-20 { font: 400 20px/30px "Work Sans", sans-serif; color: #7A7A7A; }
  .gs-divider {
    width: 2px;
    height: 120px;
    margin: 44px auto -25px;
    background: #51719A;
  }
  .gs-ready { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .gs-ready-title {
    margin-bottom: 40px;
    font-family: "Orange and Lemons Caps", sans-serif;
    font-size: 109px;
    font-weight: 400;
    line-height: 0.6em;
    letter-spacing: -1px;
    text-shadow: 3px 2px 0 #fff;
    color: #C45B8F;
    text-align: center;
  }
  .gs-ready-text {
    margin: 19px;
    font-family: Poppins, sans-serif;
    font-size: 38px;
    font-weight: 300;
    line-height: 38px;
    letter-spacing: -0.5px;
    color: #C45B8F;
    text-align: center;
  }
  .gs-down { position: relative; z-index: 2; display: block; width: 11%; min-width: 64px; }
  .gs-down img { width: 100%; display: block; }

  /* Form over the photo */
  .gs-form-section {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    margin-top: -4%;
    padding: 124px 11%;
    background: #fff url("/images/IMG_6199.jpg") center / cover no-repeat;
  }
  .gs-card {
    width: 100%;
    max-width: 981px;
    padding: 10%;
    background: #fff;
    box-shadow: 0 0 28px 5px rgba(0, 0, 0, .33);
    scroll-margin-top: 20px;
  }
  .gs-form-title {
    margin-bottom: 20px;
    font-family: Poppins, sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 32px;
    letter-spacing: -0.5px;
    color: #743E5A;
  }
  .gs-msg { margin: 0 0 20px; padding: 14px 18px; border-radius: 4px; font: 500 15px/1.5 Poppins, sans-serif; }
  .gs-msg.ok { background: #EAF6EC; color: #1E5631; border: 1px solid #A6D4B0; }
  .gs-msg.err { background: #FCEBEA; color: #9B1C12; border: 1px solid #E8B4AE; }

  .gs-form { font-family: Poppins, sans-serif; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .field { display: block; margin: 0 0 16px; padding: 0; border: 0; min-width: 0; }
  .label {
    display: block;
    margin-bottom: 8px;
    padding: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #3A3A3B;
  }
  .small .label { font-size: 14px; }
  .req { font-size: 13px; font-style: italic; font-weight: 400; color: #C02B0A; }
  .split { display: flex; gap: 16px; }
  .split > * { flex: 1 1 0; min-width: 0; }
  .split > .field { margin-bottom: 16px; }
  .sub { display: flex; flex-direction: column; font-size: 14px; line-height: 1.3; color: #4D4D4D; }
  .small .sub { font-size: 13px; }
  .desc { display: block; margin-top: 6px; font-size: 12px; color: #858585; }
  .gs-form input[type="text"],
  .gs-form input[type="email"],
  .gs-form input[type="tel"],
  .gs-form textarea {
    display: block;
    width: 100%;
    margin: 0 0 4px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid #908EC7;
    border-radius: 0;
    background: transparent;
    font: 400 15px/1.4 Poppins, sans-serif;
    color: #6A6A6A;
    text-indent: 5px;
  }
  .gs-form input { height: 38px; }
  .gs-form textarea { height: 288px; resize: vertical; }
  .gs-form input::placeholder { color: #6A6A6A; opacity: .8; font-size: 13px; }
  .gs-form input:focus, .gs-form textarea:focus { outline: 2px solid #EA82B6; outline-offset: 1px; }
  .checks .label { margin-bottom: 10px; }
  .check {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    font-size: 14px;
    color: #4D4D4D;
  }
  .check input { width: 14px; height: 14px; margin: 0; accent-color: #C45B8F; }
  .select-all {
    margin-top: 10px;
    padding: 11px 14px;
    border: 1px solid #C45B8F;
    border-radius: 4px;
    background: #fff;
    font: 400 15px/1 Poppins, sans-serif;
    color: #C45B8F;
    cursor: pointer;
  }
  .select-all:hover { background: #FFF3F7; }
  .submit {
    width: var(--submit-w);
    max-width: 100%;
    margin-top: 30px;
    padding: 15.7px 0;
    border: 0;
    border-radius: 0;
    background: #FFB98D;
    box-shadow: 2px 2px 0 0 #C99674;
    font: 700 16px/1.2 Poppins, sans-serif;
    color: #fff;
    cursor: pointer;
    transition: background-color .3s;
  }
  .submit:hover, .submit:focus-visible { background: #F9A672; }

  /* FAQ */
  .gs-faq {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-top: -6%;
    padding: 0 2% 5%;
    background: #743E5A;
  }
  .gs-faq-icon { width: 120px; display: block; transform: translateY(-61px); margin-bottom: -50px; }
  .gs-faq-title {
    font-family: Poppins, sans-serif;
    font-size: 52px;
    font-weight: 300;
    line-height: 52px;
    letter-spacing: -0.5px;
    color: #fff;
    text-align: center;
  }
  .gs-faq-text {
    width: 100%;
    max-width: 873px;
    padding: 0 20px;
    font: 400 19px/31px Poppins, sans-serif;
    color: #fff;
  }
  .gs-faq-text :global(p) { margin: 0 0 14.4px; }
  .gs-faq-text :global(strong), .gs-faq-text :global(b) { font-weight: 700; }

  /* Tablets */
  @media (max-width: 1024px) {
    .gs-title { font-size: min(var(--title-size), 13vw); }
    .gs-ready-title { font-size: 90px; }
    .gs-ready-text { font-size: 32px; line-height: 36px; }
    .gs-step { padding: 0 24px; }
  }

  /* Phones */
  @media (max-width: 767px) {
    .gs-hero { padding: 6%; }
    .gs-hero { gap: 14px; }
    .gs-tagline { margin-bottom: 0; font-size: 46px; line-height: 48px; }
    .gs-title { margin-bottom: 10px; padding-top: 0; font-size: min(var(--title-size), 84px); line-height: 0.85; }
    .gs-how-inner { margin-top: 0; padding: 30px 5% 0; }
    .gs-how-icon { width: 150px; }
    .gs-how-title { padding: 0 0 10px; transform: none; font-size: 46px; line-height: 50px; }
    .gs-row { flex-direction: column; gap: 30px; }
    .gs-row.single { margin-bottom: 0; }
    .gs-step { padding: 0 10px; }
    .gs-step-text.poppins-19, .gs-step-text.poppins-18 { font-size: 16px; line-height: 26px; }
    .gs-step-text.worksans-20 { font-size: 17px; line-height: 27px; }
    .gs-divider { margin: 20px auto 0; height: 80px; }
    .gs-ready { padding: 0 0 5%; }
    .gs-ready-title { margin-bottom: 10px; font-size: 62px; line-height: 0.95; }
    .gs-ready-text { margin: 0 0 10px; font-size: 26px; line-height: 30px; }
    .gs-down { width: 64px; }
    .gs-form-section { margin-top: -32px; padding: 44px var(--pad, 3%) 60px; }
    .gs-card { padding: 30px 20px; }
    .gs-form-title { font-size: 28px; line-height: 32px; }
    .split { flex-direction: column; gap: 0; }
    .split > .sub { margin-bottom: 12px; }
    .gs-faq { margin-top: -30px; padding: 0 6% 12%; }
    .gs-faq-icon { width: 100px; transform: translateY(-40px); margin-bottom: -30px; }
    .gs-faq-title { font-size: 38px; line-height: 42px; }
    .gs-faq-text { padding: 0; font-size: 16px; line-height: 26px; }
  }
</style>
