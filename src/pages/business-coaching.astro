---
import BaseLayout from "../layouts/BaseLayout.astro";
import icons from "../data/business-coaching-icons.json";

const EMILY = "https://wildflowertherapyco.janeapp.com/#/discipline/3/treatment/18";
const CHACHI = "/chachi/";

const struggles = [
  ["Still working in your traditional 9-5 working for someone else's dream", "but you're looking for a way to start something that's uniquely yours and you need help with the vision to get there."],
  ["Hard at work in your own traditional practice", "but feeling bogged down by the time-capped one-on-one model and you're desperately needing some freedom from \"the grind\"."],
  ["Deep in building your online business", "and need a like-minded, SLP entrepreneur who has done it (and still doing it) to help you meet your BIG goals."],
  ["Overwhelmed with the alllllll of the online marketing strategies and courses", "(because you've taken all of them) and are just looking for some one-on-one guidance to get you over the hump."],
];

const packages = [
  [
    {
      icon: icons.search, iconSize: 68, title: "Free Discovery Call", price: "Free", emilyBorder: "#C45B8F",
      intro: "Perfect for those <strong>not sure where to start.</strong> A quick session to ask your questions before we work together.",
      items: ["15-20 minute session", "Ask questions to determine a solution for your unique needs", "No pressure sales tactics!"],
    },
    {
      icon: icons.brain, iconSize: 68, title: "Clarity Session", price: "$175",
      intro: "Perfect for those <strong>seeking quick insights and actionable advice.</strong> 50 minutes to pick our brain and walk away with clarity.",
      items: ["50 minute clarity session", "Recording sent post-meeting and yours to keep", "Session fee applied to higher package"],
    },
  ],
  [
    {
      icon: icons.blueprint, iconSize: 71, title: "Growth Blueprint", price: "$497",
      intro: "Perfect for those looking for a more structured approach to business growth and looking to <strong>take growth seriously.</strong>",
      items: ["Pre-session questionnaire", "50 minute clarity session", "Detailed business blueprint", "Three months priority email support", "50 minute follow-up session", "Recording sent post-meeting and yours to keep"],
    },
    {
      icon: icons.handshake, iconSize: 70, title: "Growth Partnership", price: "$1297",
      intro: "Perfect for those <b>wanting to level-up their growth with a close partner in crime. </b>We’ll be your business bestie for 3-6 months.",
      items: ["Pre-session questionnaire", "50 minute clarity session", "Detailed business blueprint", "50 minute follow-up session", "3 additional meetings at an interval of your choosing", "Access to the Passive Profit Plan"],
    },
  ],
];
---

<BaseLayout title="Business Coaching" description="Personalized business coaching and consult packages for SLPs: strategies, systems and support so your SLP business can grow with confidence.">
  <section class="hero">
    <h1 class="hero-title">Let's build your dream together.</h1>
    <h2 class="hero-sub">Personalized support for <b>big "omg!" results.</b></h2>
    <div class="hero-text">
      <p>Discover the <b>strategies the pros use</b>, the systems you need to <b>scale big</b>, and the <b>support you’ve always dreamed of</b> so your SLP business can <b>grow with confidence.</b></p>
    </div>
  </section>

  <section class="struggle">
    <div class="boxed struggle-inner">
      <img class="hands" src="/images/Untitled-design-2.png" alt="" width="135" height="107" loading="lazy" />
      <h2 class="battle">I get it – growing your business as an SLP can feel like an <b>impossible battle</b>.</h2>
      <h2 class="maybe">Maybe you are...</h2>
      <ul class="sad-list">
        {struggles.map(([bold, rest]) => (
          <li><span class="sad-icon" set:html={icons.sad} /><span><strong>{bold}</strong> {rest}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ready">
    <p class="emoji" aria-hidden="true">💪</p>
    <h2 class="ready-title">We know you're ready to get un-stuck and blow the roof off your big goals...</h2>
    <h2 class="ready-sub">And we're ready to partner with you and move from <b>overwhelmed to completely unstoppable.</b></h2>
  </section>

  <section class="packages">
    <div class="boxed packages-inner">
      <h2 class="help-script">Here's how we can help</h2>
      <h2 class="packages-title">Business Coaching &amp; Consult Packages</h2>
      <div class="packages-text">
        <p>Decide your package and book a free discovery call to get started. </p>
        <p>Don’t know what you need? No worries. We can help during the discovery call!</p>
      </div>
      {packages.map((row, r) => (
        <div class:list={["grid", { "grid-2": r === 1 }]}>
          {row.map((p) => (
            <div class="card">
              <span class="card-icon" style={`--size:${p.iconSize}px`} set:html={p.icon} />
              <h3 class="card-title">{p.title}</h3>
              <p class="card-price">{p.price}</p>
              <p class="card-intro" set:html={p.intro} />
              <ul class="check-list">
                {p.items.map((it) => <li><span class="check" set:html={icons.check} /><span>{it}</span></li>)}
              </ul>
              <a class="book book-emily" href={EMILY} style={p.emilyBorder ? `border-color:${p.emilyBorder}` : undefined}>
                <span class="book-img"><img src="/images/bookw-emily-final.png" alt="" width="79" height="79" loading="lazy" /></span>
                <span class="book-label">Book with Emily</span>
              </a>
              <a class="book book-chachi" href={CHACHI}>
                <span class="book-img"><img src="/images/book-with-chachi.png" alt="" width="79" height="79" loading="lazy" /></span>
                <span class="book-label">Book with Chachi</span>
              </a>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2, h3 { letter-spacing: -0.5px; }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 8% 0 5%;
    background-image: linear-gradient(98deg, #FFF2F7 0%, #FEFCFD 100%);
    text-align: center;
  }
  .hero-title {
    margin: 0 0 -25px;
    font-family: "Orange and Lemon Upright", sans-serif;
    font-size: 182px;
    font-weight: 300;
    line-height: 1;
    color: #C45B8F;
  }
  .hero-sub {
    margin: 0 0 35px;
    font-family: Poppins, sans-serif;
    font-size: 44px;
    font-weight: 300;
    line-height: .6em;
    letter-spacing: -1px;
    color: #E192B9;
  }
  .hero-sub b { font-weight: 400; }
  .hero-text {
    width: 47%;
    font-family: Poppins, sans-serif;
    font-size: 22px;
    line-height: 1.5;
    color: #7A7A7A;
  }
  .hero-text p { margin-bottom: 14.4px; }

  /* Struggles */
  .struggle { position: relative; margin-top: -4%; padding: 1% 0 4%; }
  .struggle-inner { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .hands { width: 135px; }
  .battle {
    margin: 34px 0;
    font-family: Poppins, sans-serif;
    font-size: 51px;
    font-weight: 300;
    line-height: 50px;
    color: #C45B8F;
    text-align: center;
  }
  .battle b { font-weight: 400; }
  .maybe {
    font-family: Poppins, sans-serif;
    font-size: 37px;
    font-weight: 300;
    line-height: 1;
    color: #54595F;
    text-align: center;
  }
  .sad-list { width: 70%; margin: 0; padding: 0; list-style: none; }
  .sad-list li {
    display: flex;
    align-items: flex-start;
    font-family: Poppins, sans-serif;
    font-size: 20px;
    line-height: 30px;
    color: #5A5A5A;
  }
  .sad-list li:not(:last-child) { padding-bottom: 14.5px; }
  .sad-list li:not(:first-child) { margin-top: 14.5px; }
  .sad-icon { flex: none; display: inline-flex; width: 27px; margin: 7px 3.4px 0; padding-inline-end: 6px; box-sizing: content-box; }
  .sad-icon :global(svg) { width: 27px; height: 27px; fill: #C45B8F; }
  .sad-list strong { font-weight: 700; }
  .sad-list li > span:last-child { padding-left: 5px; }

  /* Plum/rose band */
  .ready {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 6% 7%;
    background: #C45B8F;
    text-align: center;
  }
  .emoji { margin: 0; font-family: "Playfair Display", serif; font-size: 40px; font-weight: 300; line-height: 1; }
  .ready-title {
    max-width: 1263px;
    font-family: "Orange and Lemons Caps", sans-serif;
    font-size: 120px;
    font-weight: 300;
    line-height: 69px;
    color: #6D1A43;
  }
  .ready-sub {
    width: 85%;
    margin: 31px 10px 10px;
    font-family: Poppins, sans-serif;
    font-size: 28px;
    font-weight: 300;
    line-height: 38px;
    color: #fff;
  }
  .ready-sub b { font-weight: 400; }

  /* Packages */
  .packages { padding: 5% 0 4%; }
  .packages-inner { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .help-script {
    margin-bottom: -1%;
    font-family: "Orange and Lemons Script", sans-serif;
    font-size: 83px;
    font-weight: 300;
    line-height: 1;
    color: #C45B8F;
    text-align: center;
  }
  .packages-title {
    font-family: Poppins, sans-serif;
    font-size: 41px;
    font-weight: 800;
    line-height: 1;
    color: #743E5B;
    text-align: center;
  }
  .packages-text {
    width: 56%;
    font-family: Poppins, sans-serif;
    font-size: 20px;
    line-height: 30px;
    color: #7A7A7A;
    text-align: center;
  }
  .packages-text p { margin-bottom: 14.4px; }
  .grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 4%;
  }
  .grid-2 { padding: 10px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 9%;
    background: #fff;
    box-shadow: 1px 1px 10px 0 rgba(0, 0, 0, .15);
  }
  .card-icon { display: flex; justify-content: center; padding-bottom: 7px; }
  .card-icon :global(svg) { height: var(--size); width: auto; fill: #5C5B86; }
  .card-title {
    font-family: Poppins, sans-serif;
    font-size: 29px;
    font-weight: 400;
    line-height: 1;
    color: #565656;
    text-align: center;
  }
  .card-price {
    margin: -2% 0;
    font-family: "Orange and Lemons Caps", sans-serif;
    font-size: 63px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.5px;
    color: #C45B8F;
    text-align: center;
  }
  .card-intro {
    margin: 0 0 14.4px;
    font-family: Poppins, sans-serif;
    font-size: 19px;
    line-height: 1.5;
    color: #7A7A7A;
  }
  .card-intro :global(strong), .card-intro :global(b) { font-weight: 700; }
  .check-list { margin: 0 0 5%; padding: 0; list-style: none; }
  .check-list li {
    display: flex;
    align-items: flex-start;
    font-family: Poppins, sans-serif;
    font-size: 19px;
    line-height: 1.5;
    color: #767676;
  }
  .check-list li:not(:last-child) { padding-bottom: 8px; }
  .check-list li:not(:first-child) { margin-top: 8px; }
  .check-list li > span:last-child { padding-left: 11px; }
  .check { flex: none; display: inline-flex; width: 22px; margin-top: 3px; padding-inline-end: 6px; box-sizing: content-box; }
  .check :global(svg) { width: 22px; height: 22px; fill: #908EC7; }
  .book {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 10px;
    border: 2px solid #908EC7;
    border-radius: 6px;
    font-weight: 300;
  }
  .book-chachi { border-color: #FF9A8C; }
  .book-img { flex: 0 0 29%; display: flex; align-items: center; justify-content: center; padding: 10px; }
  .book-img img { width: 79px; }
  .book-label {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    padding: 10px;
    font-family: Poppins, sans-serif;
    font-size: 31px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.5px;
    color: #908EC7;
  }
  .book-chachi .book-label { color: #fca48c; }

  @media (max-width: 1024px) {
    .hero-title { font-size: 120px; margin-bottom: -16px; }
    .hero-text { width: 70%; }
    .ready-title { font-size: 90px; line-height: 60px; }
    .book-label { font-size: 21px; }
  }

  @media (max-width: 767px) {
    .hero { padding: 7% 7% 14%; }
    .hero-title { margin-bottom: -7px; font-size: 62px; line-height: .7em; }
    .hero-sub { margin-bottom: 13px; font-size: 54px; }
    .hero-text { width: 100%; max-width: 894px; }
    .struggle { margin-top: -11%; padding: 0 6% 14%; }
    .battle { margin: 10px 0; font-size: 45px; line-height: .7em; }
    .maybe { font-size: 50px; }
    .sad-list { width: 100%; max-width: 785px; }
    .ready { padding: 6% 7%; }
    .ready-title { max-width: 356px; font-size: 60px; line-height: .7em; }
    .ready-sub { width: 100%; max-width: 614px; margin: 10px 3px 3px; font-size: 22px; line-height: 1.5em; }
    .packages { padding: 9% 6% 0; }
    .packages-title { font-size: 33px; }
    .packages-text { width: 100%; max-width: 451px; }
    .grid { grid-template-columns: 1fr; }
    .book { flex-wrap: wrap; gap: 0; }
    .book-img { flex-basis: 100%; }
    .book-img img { width: 55%; }
    .book-label { justify-content: center; text-align: center; font-size: 28px; }
  }
</style>
