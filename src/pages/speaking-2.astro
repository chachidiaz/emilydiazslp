---
import BaseLayout from "../layouts/BaseLayout.astro";

const presentations = [
  {
    img: "/images/managing-aac-website-1024x1024.png",
    title: "Managing AAC in the Classroom: Strategies for Implementation and Buy-in Tips & Tricks",
    text: "Communication doesn’t just happen during speech therapy! This course will help you consider how to train & support classroom professionals so they feel confident in following through with implementing AAC even when you’re not there. We have rounded up the best tips & tricks for buy-in and evidence-based practices for AAC coaching and implementation for improving AAC outcomes in the classroom.",
  },
  {
    img: "/images/intro-to-aac-for-gestalt-1024x1024.png",
    title: "Introduction to AAC for Gestalt Language Processors",
    text: "This course will address what we know (and still don’t know) about everyday clinical practice for our AAC users that are gestalt language processors. It will cover both family and professional experiences while also addressing the research, identifying speaking/nonspeaking GLPs, AAC app feature matching, the theory of programming, and implementation.",
  },
  {
    img: "/images/aac-for-teams-1024x1024.png",
    title: "AAC for Teams: Built for Paras, Teachers, SLPs, and Other Related Professionals",
    text: "This course will provide foundational knowledge about AAC that is important for all team members to know. It will cover the basics ranging from what is AAC, different types of AAC, how to use AAC, common misconceptions, best practice for collaboration, AAC in the IEP, assessment and funding options, and more!",
  },
  {
    img: "/images/Intro-to-AAC-Assessment-Funding.png",
    title: "Introduction to AAC Assessment & Funding",
    text: "Choosing the right AAC system is only half the battle — securing the funding to get it into a client’s hands is just as important. In this 3-hour workshop, you’ll learn how to confidently complete an AAC assessment from start to finish, make informed device recommendations, and navigate the often-complicated world of funding. We’ll break down the assessment process, feature matching, and essential documentation, while demystifying school, insurance, and private pay funding options. You’ll leave with practical tools, clear steps, and the confidence to guide your clients from evaluation to implementation without unnecessary delays.",
  },
];

const logosRow1 = [
  { src: "/images/NavyBlueStar_Region13Logo-1024x188.png", alt: "Region 13 Education Service Center", w: 280 },
  { src: "/images/talkingaac-logo-fullcolor-small_3.png", alt: "#TalkingAAC", w: 245 },
  { src: "/images/reg14logo2010.jpg", alt: "Region 14 Education Service Center", w: 184 },
  { src: "/images/r17_logo_250.png", alt: "Region 17 Education Service Center", w: 192 },
];
const logosRow2 = [
  { src: "/images/aac-in-the-cloud-1024x1024.jpeg", alt: "AAC in the Cloud", w: 160 },
  { src: "/images/meaningful-speech-1024x576.jpeg", alt: "Meaningful Speech", w: 247 },
  { src: "/images/BRIQHT-Logo-21f5ef1a17e4d9f7b2c1f30876dcb658-1024x657.png", alt: "Bright Ideas Media", w: 198 },
  { src: "/images/speechtherapypd-logo.png", alt: "SpeechTherapyPD.com", w: 296 },
];

const topics = ["Managing AAC in the Classroom", "Introduction to AAC for GLP", "AAC for Teams", "Intro to AAC Assessment & Funding", "Other Not Listed"];
const formats = ["In-Person Speaking", "Virtual Speaking"];
---

<BaseLayout
  title="Speaking & Professional Development"
  description="Book Emily Diaz, SLP to speak: AAC presentations for schools, districts and conferences."
>
  <section class="hero">
    <p class="hero-eyebrow">Let's get started with</p>
    <h1 class="hero-title">Speaking &amp; professional Development</h1>
  </section>

  <section class="presentations">
    <img class="speech-icon" src="/images/speech.png" alt="" width="166" height="166" />
    <div class="pres-inner">
      <h2 class="pres-heading">Available Presentations</h2>
      {presentations.map((p) => (
        <article class="pres-row">
          <div class="pres-img"><img src={p.img} alt="" width="492" height="492" loading="lazy" /></div>
          <div class="pres-copy">
            <h3 class="pres-title">{p.title}</h3>
            <p class="pres-hours">3 HOURS</p>
            <p class="pres-text">{p.text}</p>
          </div>
        </article>
      ))}
      <div class="featured-title-wrap">
        <h2 class="featured-title">I've been featured at...</h2>
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="logo-row logo-row-1">
      {logosRow1.map((l) => <img src={l.src} alt={l.alt} style={`--w:${l.w}px`} loading="lazy" />)}
    </div>
    <div class="logo-row logo-row-2">
      {logosRow2.map((l) => <img src={l.src} alt={l.alt} style={`--w:${l.w}px`} loading="lazy" />)}
    </div>
    <div class="divider" aria-hidden="true"><span></span></div>
    <h2 class="ready-title">Ready to get started?</h2>
    <p class="ready-text">Fill out the <a href="#request-form">Speaking Request Inquiry form</a> below to begin the process.</p>
    <a class="circle-btn" href="#request-form" aria-label="Go to the Speaking Request Inquiry form">
      <img src="/images/circle-button.png" alt="" width="108" height="108" />
    </a>
  </section>

  <section class="about-emily">
    <div class="about-inner">
      <div class="about-img">
        <img src="/images/emily-edited.png" alt="Emily Diaz laughing" width="521" height="762" loading="lazy" />
      </div>
      <div class="about-copy">
        <h2 class="about-title">About Emily</h2>
        <div class="about-text">
          <p>Emily Diaz, M.S. CCC-SLP is a certified speech-language pathologist with a passion for empowering individuals to find their voice. With a focus on neurodiversity affirming care and augmentative &amp; alternative communication (AAC), Emily offers valuable insight and support to clinicians, parents, and school districts.</p>
          <p>Emily’s expertise extends to topics like managing AAC in the classroom, the importance of staff-buy in and dynamic coaching methods, and the nuances of gestalt language processing and AAC implementation strategies.</p>
          <p>Having shared her knowledge at conferences and platforms, including Meaningful Speech, Bright Ideas Media, and SpeechPathologyPD.com, Emily stands as a beacon of expertise and innovation in the field of speech-language pathology. Discover the transformative impact of AAC with Emily Diaz, SLP.</p>
        </div>
        <a class="about-btn" href="/about/">
          <svg viewBox="0 0 320 512" aria-hidden="true"><path d="M302.189 329.126H196.105l55.831 135.993c3.889 9.428-.555 19.999-9.444 23.999l-49.165 21.427c-9.165 4-19.443-.571-23.332-9.714l-53.053-129.136-86.664 89.138C18.729 472.71 0 463.554 0 447.977V18.299C0 1.899 19.921-6.096 30.277 5.443l284.412 292.542c11.472 11.179 3.007 31.141-12.5 31.141z"/></svg>
          Learn more about Emily
        </a>
      </div>
    </div>
  </section>

  <section class="form-section" id="request-form">
    <div class="form-card">
      <h2 class="form-title">Speaking Request Inquiry Form</h2>
      <form class="gf" action="/contact-submit.php" method="post" data-compose>
        <input type="hidden" name="form" value="Speaking Request Inquiry (/speaking-2/)" />
        <input type="hidden" name="topic" value="Speaking Request Inquiry" />
        <input type="hidden" name="message" value="" />
        <div class="hp" aria-hidden="true">
          <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <fieldset class="field">
          <legend class="field-label">Name</legend>
          <div class="name-row">
            <span class="name-part">
              <input type="text" id="sp-first" name="first_name" autocomplete="given-name" required />
              <label for="sp-first" class="sub-label">First</label>
            </span>
            <span class="name-part">
              <input type="text" id="sp-last" name="last_name" autocomplete="family-name" required />
              <label for="sp-last" class="sub-label">Last</label>
            </span>
          </div>
        </fieldset>

        <div class="field">
          <label class="field-label" for="sp-email">Email</label>
          <input type="email" id="sp-email" name="email" autocomplete="email" required />
        </div>

        <fieldset class="field">
          <legend class="field-label">I'd like more information about</legend>
          <div class="choices" data-part="More information about">
            {topics.map((t) => <label class="choice"><input type="checkbox" value={t} /> {t}</label>)}
          </div>
          <button type="button" class="select-all">Select All</button>
        </fieldset>

        <fieldset class="field">
          <legend class="field-label">I'm interested in...</legend>
          <div class="choices" data-part="Interested in">
            {formats.map((t) => <label class="choice"><input type="checkbox" value={t} /> {t}</label>)}
          </div>
          <button type="button" class="select-all">Select All</button>
        </fieldset>

        <div class="field">
          <label class="field-label" for="sp-details">Please share some details about your audience and list some preferences for dates.</label>
          <textarea id="sp-details" rows="10" data-part="Audience and preferred dates"></textarea>
        </div>

        <button type="submit" class="submit">Submit</button>
      </form>
    </div>
  </section>

  <section class="faq">
    <img class="faq-icon" src="/images/qa.png" alt="" width="120" height="120" loading="lazy" />
    <h2 class="faq-title">Frequently Asked Questions</h2>
    <div class="faq-text">
      <p><b>1. Do your courses offer CEUs?</b></p>
      <p>Organizations are able to submit a request for CEUs to ASHA or their state association. We are happy to fill out the necessary paperwork for this. Otherwise, these courses are offered for Professional Development Hours (PDHs).</p>
      <p><b>2. Do you present in-person or virtually?</b></p>
      <p>We present both in-person and virtually. Please request a quote and for more information about availability.</p>
      <p><b>3. Where else have you presented before?</b></p>
      <p>We have presented for Educational Service Centers across Texas, school districts &amp; clinics across the United States, <a href="http://SpeechTherapyPD.com" target="_blank" rel="noopener noreferrer">SpeechTherapyPD.com</a>, SLP Toolkit Summer Camp, Bright Ideas Media Online Conferences, and more!</p>
    </div>
  </section>
</BaseLayout>

<script>
  // "Select All" toggles every checkbox in its group (Gravity Forms behaviour).
  document.querySelectorAll<HTMLButtonElement>(".select-all").forEach((btn) => {
    btn.addEventListener("click", () => {
      const boxes = [...btn.closest("fieldset")!.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
      const allOn = boxes.every((b) => b.checked);
      boxes.forEach((b) => (b.checked = !allOn));
      btn.textContent = allOn ? "Select All" : "Deselect All";
    });
  });

  // The site's mail handler (contact-submit.php) takes name, email, topic and
  // message. Fold this form's extra fields into the message before sending.
  document.querySelectorAll<HTMLFormElement>("form[data-compose]").forEach((form) => {
    form.addEventListener("submit", () => {
      const lines: string[] = [];
      form.querySelectorAll<HTMLElement>("[data-part]").forEach((el) => {
        const name = el.dataset.part!;
        let value = "";
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) value = el.value.trim();
        else value = [...el.querySelectorAll<HTMLInputElement>("input:checked")].map((i) => i.value).join(", ");
        lines.push(`${name}: ${value || "-"}`);
      });
      const formName = (form.querySelector<HTMLInputElement>('input[name="form"]')!).value;
      form.querySelector<HTMLInputElement>('input[name="message"]')!.value = `Form: ${formName}\n\n${lines.join("\n")}`;
    });
  });
</script>

