---
import BaseLayout from "../layouts/BaseLayout.astro";
// Recreation of https://emilydiazslp.com/free-resources (Elementor page 3764).
// The old sign-up form was an Elementor Pro form handled inside WordPress.
// It now posts to /contact-submit.php with form=free-resources (see that file).
---

<BaseLayout
  title="The Free AAC Resource Library"
  description="I've put together all of my free resources into one library for easy and life time access."
>
  <section class="library">
    <div class="library-inner">
      <div class="library-copy">
        <h1 class="title">Gain confidence in AAC</h1>
        <div class="intro">
          <p><b>I’ve put together all of my free resources into one library for easy and life time access.</b> Once I publish a new freebie, it automatically gets added here! You can download however much you need whenever you want. Gain access today!</p>
        </div>
        <p class="status status-ok" id="freebies-sent" hidden>Thank you! Check your inbox for your link to the library.</p>
        <p class="status status-error" id="freebies-error" hidden>Something went wrong. Please check your email address and try again.</p>
        <form class="freebies-form" action="/contact-submit.php" method="post" aria-label="Get the free AAC resource library">
          <input type="hidden" name="form" value="free-resources" />
          <div class="hp" aria-hidden="true">
            <label for="fr-website">Website</label>
            <input id="fr-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <label class="visually-hidden" for="fr-name">First Name</label>
          <input id="fr-name" class="field" type="text" name="first_name" placeholder="First Name" autocomplete="given-name" />
          <label class="visually-hidden" for="fr-email">Email</label>
          <input id="fr-email" class="field" type="email" name="email" placeholder="Email" required autocomplete="email" />
          <div class="btn-wrap">
            <button class="submit" type="submit">Get the Freebies</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const q = new URLSearchParams(location.search);
  if (q.has("sent")) document.getElementById("freebies-sent")!.hidden = false;
  if (q.has("error")) document.getElementById("freebies-error")!.hidden = false;
</script>

<style>
  .library {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: #FCE5DD;
    background-image: url("/images/free-resources-background-scaled.jpg");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  /* Pink fade over the left of the photo so the text stays readable. */
  .library::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, #FCE5DD 26%, #F2295B00 64%);
    opacity: 0.9;
  }
  .library-inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 900px;
  }
  .library-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 47%;
    margin-top: -14%;
    padding-left: 9%;
  }
  .title {
    font-family: Poppins, sans-serif;
    font-size: 101px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.5px;
    color: #E192B9;
  }
  .intro {
    max-width: 487px;
    margin-bottom: -3%;
    font-family: Poppins, sans-serif;
    font-size: 20px;
    line-height: 30px;
    color: #64195B;
  }
  .intro p { margin-bottom: 14.4px; }
  .freebies-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 383px;
    max-width: 100%;
  }
  .field {
    width: 100%;
    min-height: 59px;
    padding: 12px 24px;
    font-family: Karla, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    color: #1f2124;
    background: #fff;
    border: 1px solid #69727D;
    border-radius: 5px;
  }
  .field::placeholder { color: #9b9b9b; }
  .field:focus { outline: none; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .1); }
  .btn-wrap { width: 66%; }
  .submit {
    width: 100%;
    min-height: 90px;
    padding: 25px 50px;
    font-family: Poppins, sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 20px;
    color: #fff;
    background: #C45B8F;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: filter .3s;
  }
  .submit:hover, .submit:focus-visible { filter: brightness(1.08); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status {
    max-width: 383px;
    margin: 0;
    padding: 12px 16px;
    border-radius: 5px;
    font-family: Poppins, sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }
  .status-ok { background: #fff; color: #64195B; border: 1px solid #C45B8F; }
  .status-error { background: #fff; color: #b3261e; border: 1px solid #b3261e; }

  @media (max-width: 1024px) {
    .library-copy { width: 60%; margin-top: 0; padding: 60px 0 60px 6%; }
    .title { font-size: 80px; }
  }
  @media (max-width: 767px) {
    .library { padding: 0 5% 5%; }
    .library-inner { min-height: 0; align-items: flex-start; }
    .library-copy { width: 100%; padding: 17.55px 3.5px 3.5px; }
    /* The old site set 101px here too, which ran off the screen. */
    .title { font-size: 56px; }
    .freebies-form { width: 241px; }
    .field { padding: 12px 20px; }
    .submit { padding: 25px 20px; }
  }
</style>
