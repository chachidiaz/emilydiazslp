---
// Recreation of https://emilydiazslp.com/chachi (Elementor page 3449).
// Like the old page, it has no site header or footer: just Chachi's intro and
// his Google Calendar booking page.
import { site } from "../data/site";
import "../styles/global.css";

const title = `Book with Chachi - ${site.title}`;
const description = "Ready to talk websites, email marketing, and launching? Grab a time on my calendar below!";
const canonical = new URL(Astro.url.pathname, Astro.site);
const isPreview = import.meta.env.PUBLIC_PREVIEW === "1";
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/emily-maroon-logo.webp" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    {!isPreview && (
      <Fragment>
        <script async src="https://www.googletagmanager.com/gtag/js?id=GT-TWQZ763"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'GT-TWQZ763');
        </script>
      </Fragment>
    )}
  </head>
  <body class="chachi-page">
    <main id="main">
      <section class="intro">
        <div class="intro-row">
          <div class="photo">
            <img src="/images/book-with-chachi.png" alt="book with chachi" width="222" height="222" />
          </div>
          <div class="copy">
            <h1>Book with Chachi</h1>
            <p>Ready to talk websites, email marketing, and launching? Let’s do it. Grab a time on my calendar below! Can’t wait to get into it!</p>
          </div>
        </div>
      </section>
      <section class="calendar">
        <div class="calendar-card">
          <!-- Google Calendar Appointment Scheduling -->
          <iframe
            src="https://calendar.google.com/calendar/appointments/AcZssZ17jy98sAGKkKKe4TsSZ3ftJIo8PczI0JmcbiE=?gv=true"
            title="Book a time with Chachi"
            width="100%"
            height="1000"
            frameborder="0"
            style="border: 0"></iframe>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body.chachi-page) { background-color: #C6D0D5; }
  .intro { padding-top: 72px; }
  .intro-row {
    display: flex;
    gap: 20px;
    max-width: 1285px;
    margin: 0 auto;
    padding: 10px;
  }
  .photo { flex: 0 0 19%; display: flex; padding: 10px; }
  .photo img { width: 222px; display: block; }
  .copy {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding: 10px;
  }
  h1 {
    font-family: "Tommy Soft", sans-serif;
    font-size: 71px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -4.4px;
    text-transform: lowercase;
    color: #3F3F3F;
  }
  .copy p {
    margin: 0 0 14.4px;
    font-family: Poppins, sans-serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 36px;
    color: #494949;
  }
  .calendar { min-height: 900px; padding: 0 10px; }
  .calendar-card {
    padding: 2% 2% 3%;
    background: #fff;
    border-radius: 0 0 0 11px;
  }
  iframe { display: block; }

  @media (max-width: 767px) {
    .intro { padding-top: 20px; }
    .intro-row { flex-direction: column; gap: 20px; }
    .photo { flex: none; }
    .photo img { width: 157px; }
    h1 { font-size: 43px; }
  }
</style>
